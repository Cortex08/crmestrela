@echo off
title Bloqueador de PC - Instalador - versao 1.5
:: ===========================================================
::  BLOQUEADOR DE PC - arquivo unico
::  Duplo clique: instala tudo (baixa o Python se precisar).
::  Integrado ao CRM: login, liberacao remota e registros.
::  Para remover: BloqueadorPC.bat desinstalar
:: ===========================================================

:: Pede permissao de administrador automaticamente
net session >nul 2>&1
if %errorlevel% neq 0 (
  if "%~1"=="" (
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
  ) else (
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -ArgumentList '%~1' -Verb RunAs"
  )
  exit /b
)

set "BPC_ARG=%~1"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText('%~f0',[Text.Encoding]::UTF8); $i=$t.IndexOf('##PS'+'START'); Invoke-Expression $t.Substring($i)"
echo.
pause
exit /b
##PSSTART
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$VersaoBloqueador = '1.5'
$Desinstalar = ($env:BPC_ARG -match 'desinstalar')
$Reconf = ($env:BPC_ARG -match 'reconfigurar')

# ---------------------------------------------------------------------------
# Configuracoes
# ---------------------------------------------------------------------------
$PyVersao = '3.12.8'
$PyUrl    = "https://www.python.org/ftp/python/$PyVersao/python-$PyVersao-amd64.exe"
$Pasta    = Join-Path $env:ProgramFiles 'BloqueadorPC'   # programa (so admin altera)
$Dados    = Join-Path $env:ProgramData  'BloqueadorPC'   # usuarios e log
$Tarefa   = 'BloqueadorPC'

# SIDs (funcionam em qualquer idioma do Windows)
$SidSystem = '*S-1-5-18'
$SidAdmins = '*S-1-5-32-544'
