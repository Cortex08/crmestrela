function Decodificar($b64) {
    $limpo = $b64 -replace '\s', ''
    return [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($limpo))
}

function Escrever($msg, $cor = 'White') { Write-Host $msg -ForegroundColor $cor }

# Mostra um indicador de atividade (giratorio + tempo) enquanto algo demorado roda
function Mostrar-Atividade($texto, [scriptblock]$terminou) {
    $giro = '|', '/', '-', '\'
    $i = 0
    $ini = Get-Date
    while (-not (& $terminou)) {
        $seg = [int]((Get-Date) - $ini).TotalSeconds
        Write-Host ("`r      {0} {1}  ({2}:{3:00})   " -f $giro[$i % 4], $texto, [int][math]::Floor($seg / 60), ($seg % 60)) -NoNewline -ForegroundColor DarkYellow
        $i++
        Start-Sleep -Milliseconds 250
    }
    Write-Host ("`r      OK  {0}                                        " -f $texto) -ForegroundColor Green
}

function Rodar($exe, $argumentos, $texto = '') {
    $p = Start-Process -FilePath $exe -ArgumentList $argumentos -PassThru -WindowStyle Hidden
    if ($texto) { Mostrar-Atividade $texto { $p.HasExited } } else { $p.WaitForExit() }
    $p.WaitForExit()
    return $p.ExitCode
}

# Procura um Python 3 que tenha tkinter funcionando
function Achar-Python {
    $candidatos = @()
    $candidatos += Get-ChildItem "$env:ProgramFiles\Python3*\python.exe" -ErrorAction SilentlyContinue | ForEach-Object { $_.FullName }
    $candidatos += Get-ChildItem "${env:ProgramFiles(x86)}\Python3*\python.exe" -ErrorAction SilentlyContinue | ForEach-Object { $_.FullName }
    $cmd = Get-Command python.exe -ErrorAction SilentlyContinue
    if ($cmd -and $cmd.Source -notmatch 'WindowsApps') { $candidatos += $cmd.Source }

    foreach ($py in $candidatos) {
        if (-not (Test-Path $py)) { continue }
        if ((Rodar $py '-c "import tkinter"') -eq 0) { return $py }
    }
    return $null
}

function Proteger-Pasta($caminho) {
    & icacls $caminho /inheritance:r /grant:r "${SidSystem}:(OI)(CI)F" "${SidAdmins}:(OI)(CI)F" "${SidUsers}:(OI)(CI)RX" | Out-Null
}

function Gravar-Config {
    $cfgPath = Join-Path $Dados 'config.json'
    $urlPadrao = 'https://xwcuaicofmufcdzhtkqr.supabase.co/functions/v1/pc-bloqueio'
    $url = Read-Host "URL do servidor do CRM [Enter = $urlPadrao]"
    if (-not $url) { $url = $urlPadrao }
    if ($url -notmatch '^https://') { throw 'A URL precisa comecar com https://' }
    # Campo visivel (o campo oculto mostra so 1 asterisco ao colar e confunde)
    Escrever 'Cole o token deste PC (CRM > Acesso ao Computador > Computadores) e aperte Enter:' Cyan
    $token = (Read-Host 'Token').Trim().Trim('"').Trim("'")
    if ($token.Length -lt 32) { throw "Token invalido: so $($token.Length) caracteres (confira se copiou inteiro)." }
    Escrever ("Token recebido: {0}...{1}  ({2} caracteres)" -f $token.Substring(0,4), $token.Substring($token.Length-4), $token.Length) Green
    # limpa a tela para o token nao ficar exposto
    Start-Sleep -Seconds 2
    Clear-Host
    New-Item -ItemType Directory -Path $Dados -Force | Out-Null
    $json = (@{ url = $url; token = $token } | ConvertTo-Json -Compress)
    [IO.File]::WriteAllText($cfgPath, $json, (New-Object Text.UTF8Encoding $false))
    # so administradores alteram; o programa (usuario comum) apenas le
    & icacls $cfgPath /inheritance:r /grant:r "${SidSystem}:F" "${SidAdmins}:F" "${SidUsers}:R" | Out-Null
}

# ---------------------------------------------------------------------------
# Desinstalar
# ---------------------------------------------------------------------------
if ($Desinstalar) {
    Escrever 'Removendo o bloqueador...' Yellow
    Unregister-ScheduledTask -TaskName $Tarefa -Confirm:$false -ErrorAction SilentlyContinue
    Get-Process pythonw -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
    Remove-Item $Pasta -Recurse -Force -ErrorAction SilentlyContinue
    $resp = Read-Host 'Apagar tambem a configuracao deste PC, o cache de logins e o log? (S/N)'
    if ($resp -match '^[sS]') { Remove-Item $Dados -Recurse -Force -ErrorAction SilentlyContinue }
    Escrever 'Pronto. O Python nao foi desinstalado.' Green
    return
}

# ---------------------------------------------------------------------------
# Reconfigurar (trocar URL/token sem reinstalar)
# ---------------------------------------------------------------------------
if ($Reconf) {
    Gravar-Config
    Escrever 'Configuracao atualizada. Reinicie o computador ou rode o iniciador para aplicar.' Green
    return
}

# ---------------------------------------------------------------------------
# Instalar
# ---------------------------------------------------------------------------
Escrever "=== Instalador do Bloqueador de PC - versao $VersaoBloqueador ===" Cyan

# 1) Python
$python = Achar-Python
if ($python) {
    Escrever "[1/5] Python ja instalado: $python" Green
} else {
    Escrever "[1/5] Baixando o Python $PyVersao (python.org)..." Yellow
    $instalador = Join-Path $env:TEMP "python-$PyVersao-amd64.exe"
    $job = Start-Job -ScriptBlock {
        param($u, $o)
        $ProgressPreference = 'SilentlyContinue'
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        Invoke-WebRequest -Uri $u -OutFile $o -UseBasicParsing
    } -ArgumentList $PyUrl, $instalador
    Mostrar-Atividade 'Baixando o Python, aguarde' { $job.State -ne 'Running' }
    $falhou = $job.State -ne 'Completed'
    Remove-Job $job -Force
    if ($falhou -or -not (Test-Path $instalador)) { throw 'Falha ao baixar o Python. Confira a internet e tente de novo.' }

    # Confere se o arquivo baixado e assinado pela Python Software Foundation
    $assinatura = Get-AuthenticodeSignature $instalador
    if ($assinatura.Status -ne 'Valid' -or $assinatura.SignerCertificate.Subject -notmatch 'Python Software Foundation') {
        Remove-Item $instalador -Force -ErrorAction SilentlyContinue
        throw 'O instalador baixado nao tem assinatura valida da Python Software Foundation. Abortado.'
    }

    Escrever '      Instalando o Python (pode levar alguns minutos, nao feche esta janela)...' Yellow
    $codigo = Rodar $instalador '/quiet InstallAllUsers=1 PrependPath=1 Include_tcltk=1 Include_launcher=0 Include_test=0' 'Instalando o Python, aguarde'
    Remove-Item $instalador -Force -ErrorAction SilentlyContinue
    if ($codigo -ne 0) { throw "Falha ao instalar o Python (codigo $codigo)." }

    $python = Achar-Python
    if (-not $python) { throw 'Python instalado, mas nao foi encontrado com tkinter.' }
    Escrever "      Python instalado: $python" Green
}

# 2) Arquivos do programa (somente administradores podem alterar)
Escrever '[2/5] Instalando o programa...' Yellow
New-Item -ItemType Directory -Path $Pasta -Force | Out-Null
$utf8SemBom = New-Object Text.UTF8Encoding $false
$utf8ComBom = New-Object Text.UTF8Encoding $true
[IO.File]::WriteAllText((Join-Path $Pasta 'bloqueador.py'), (Decodificar $B64_Bloqueador), $utf8SemBom)
[IO.File]::WriteAllText((Join-Path $Pasta 'iniciar.ps1'),   (Decodificar $B64_Iniciar),    $utf8ComBom)
Proteger-Pasta $Pasta

# 3) Pasta de dados: config (so admin altera) e subpasta local (cache de login, fila de eventos e log)
Escrever '[3/5] Preparando pasta de dados...' Yellow
New-Item -ItemType Directory -Path $Dados -Force | Out-Null
Proteger-Pasta $Dados
$local = Join-Path $Dados 'local'
New-Item -ItemType Directory -Path $local -Force | Out-Null
& icacls $local /grant "${SidUsers}:(OI)(CI)M" | Out-Null   # usuarios comuns so escrevem aqui

# 5) Tarefa agendada: a cada logon, o iniciador confere o Python e abre o bloqueio
Escrever '[4/5] Configurando inicio automatico...' Yellow
# Abre o bloqueio DIRETO com o pythonw (sem passar pelo PowerShell: mais rapido no logon e sem janela piscando)
$pythonw   = Join-Path (Split-Path $python) 'pythonw.exe'
if (-not (Test-Path $pythonw)) { throw "pythonw.exe nao encontrado em $(Split-Path $python)" }
$acao      = New-ScheduledTaskAction -Execute $pythonw -Argument "`"$Pasta\bloqueador.py`"" -WorkingDirectory $Pasta
$gatilho   = New-ScheduledTaskTrigger -AtLogOn
$principal = New-ScheduledTaskPrincipal -GroupId 'S-1-5-32-545' -RunLevel Limited
$config    = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries `
              -ExecutionTimeLimit ([TimeSpan]::Zero) -MultipleInstances IgnoreNew
Register-ScheduledTask -TaskName $Tarefa -Action $acao -Trigger $gatilho -Principal $principal `
    -Settings $config -Force | Out-Null

# 6) Conexao com o CRM (URL + token exclusivo deste PC)
Escrever '[5/5] Conexao com o CRM' Yellow
if (-not (Test-Path (Join-Path $Dados 'config.json'))) {
    Gravar-Config
} else {
    $r = Read-Host 'Este PC ja esta configurado. Trocar URL/token? (S/N)'
    if ($r -match '^[sS]') { Gravar-Config }
}
Escrever 'Testando a conexao com o CRM...' Yellow
& $python (Join-Path $Pasta 'bloqueador.py') --testar

Escrever ''
Write-Host '  ==================================================' -ForegroundColor Green
Write-Host '    INSTALACAO CONCLUIDA COM SUCESSO!' -ForegroundColor Green
Write-Host '  ==================================================' -ForegroundColor Green
Escrever ''
Write-Host '    O bloqueador esta instalado e vai funcionar.' -ForegroundColor White
Write-Host '    >> REINICIE O COMPUTADOR para ele ser ativado. <<' -ForegroundColor Yellow
Escrever ''
Escrever 'Senhas e liberacoes sao gerenciadas no CRM (Administracao > Acesso ao Computador).' DarkGray
Escrever 'Para trocar URL/token: execute este arquivo com o parametro: reconfigurar' DarkGray
Escrever 'Para desinstalar: execute este arquivo pelo terminal com o parametro: desinstalar' DarkGray
Escrever ''
$agora = Read-Host 'Reiniciar o computador agora? (S/N)'
if ($agora -match '^[sS]') {
    Escrever 'Reiniciando em 15 segundos... salve o que estiver aberto.' Yellow
    & shutdown.exe /r /t 15 /c "Reinicio para ativar o Bloqueador de PC"
} else {
    Escrever 'Tudo certo. Lembre-se de reiniciar o computador para ativar o bloqueio.' Yellow
}
